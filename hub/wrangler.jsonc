{
  // Ein Worker fuer alles:
  //   jf.veerka.mp/         Startseite (hub/dist/index.html)
  //   jf.veerka.mp/fwdv3/   Einsatzbereit (hub/dist/fwdv3/index.html)
  //   jf.veerka.mp/brennen-loeschen/  Brennen & Loeschen
  //   jf.veerka.mp/absichern/         Erst sichern!
  //   jf.veerka.mp/loeschlos/         Loeschlos (mehrere Dateien, PWA)
  //   jf.veerka.mp/nachweis/          Pruefseite fuer den Jugendwart
  //
  // Alle Seiten liegen damit auf derselben Domain – nur so teilen sie sich
  // den Browserspeicher, und ein gemeinsamer Fortschritt ueber mehrere Themen
  // hinweg ist ueberhaupt moeglich.
  //
  // Eine Route, eine Custom Domain: jf.veerka.mp. Den DNS-Eintrag dafuer hat
  // Cloudflare beim ersten Deploy selbst angelegt; von Hand anfassen muss man
  // ihn nicht. Weitere Hostnamen gibt es bewusst nicht mehr.
  "name": "jf",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "assets": {
    // Relativ zu DIESER Datei, also hub/dist – dem einzigen dist/ im Repo.
    // Es gab hier schon einmal ein zweites dist/ in der Wurzel (das rohe
    // Spiel); ein Deploy, der "./dist" von der Wurzel aus auflöst, hat dann
    // still die falsche Seite veröffentlicht. Die Zwischenstände liegen
    // deshalb in bau/. Wer das rückgängig macht, holt die Falle zurück.
    "directory": "./dist",
    "binding": "ASSETS",
    // Pflicht, damit die Umleitungen im Worker (Pfad ohne Schraegstrich,
    // /löschlos mit Umlaut) vor der Dateiauslieferung greifen.
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "jf.veerka.mp", "custom_domain": true }
  ]
}
